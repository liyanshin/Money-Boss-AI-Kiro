# AWS_ACCESS_KEY_ID: Required for Amazon Bedrock API calls.
# Configure this via AWS IAM credentials or environment injection.
AWS_ACCESS_KEY_ID="MY_AWS_ACCESS_KEY_ID"

# AWS_SECRET_ACCESS_KEY: Required for Amazon Bedrock API calls.
AWS_SECRET_ACCESS_KEY="MY_AWS_SECRET_ACCESS_KEY"

# AWS_REGION: The AWS region where your Bedrock models are enabled.
# Default: us-east-1
AWS_REGION="us-east-1"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
